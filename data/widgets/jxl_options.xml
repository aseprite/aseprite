<gui>
<window id="jxl_options" text="@.title">
  <grid columns="2">
    <boxfiller />
    <hbox>
      <label text="@.speed_slowest" />
      <boxfiller />
      <label text="@.speed_fastest" />
    </hbox>

    <label text="@.speed" for="speed" />
    <slider min="0" max="4" id="speed" cell_align="horizontal" width="128" />

    <check id="lossy" text="@.lossy_encoding" cell_hspan="2" />

    <label text="@.quality" id="quality_label" for="quality" />
    <slider min="0" max="100" id="quality" cell_align="horizontal" width="128" />

    <separator horizontal="true" cell_hspan="2" />

    <hbox cell_hspan="2">
      <check text="@general.dont_show" id="dont_show" tooltip="@general.dont_show_tooltip" />
      <boxfiller />
      <hbox homogeneous="true">
        <button text="@general.ok" closewindow="true" id="ok" magnet="true" minwidth="60" />
        <button text="@general.cancel" closewindow="true" />
      </hbox>
    </hbox>
  </grid>
</window>
</gui>
