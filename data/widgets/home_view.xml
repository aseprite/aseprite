<gui>
  <vbox id="home_view" noborders="true" expansive="true" border="16">
    <hbox id="main_container" expansive="true" childspacing="16" >
      <vbox id="buttons" childspacing="8" border="8">
        <link id="aseprite_face" style="aseprite_face" />
        <link id="new_file" text="@.new_file" style="workspace_link" />
        <link id="open_file" text="@.open_file" style="workspace_link" />
        <link id="recover_sprites" text="@.recover_files" style="workspace_link" tooltip="@.recover_files_tooltip" />
        <separator id="news_separator" horizontal="true" style="workspace_separator" />
        <link id="news" text="@.news" style="workspace_link" />
      </vbox>
      <splitter horizontal="true" noborders="true" childspacing="4"
                expansive="true" by="percentage" position="75" id="sidebar_splitter"
                style="workspace_splitter">
        <vbox id="recents_section" noborders="true" expansive="true" childspacing="0" style="workspace_panel">
          <hbox id="recents_menu" border="4">
            <label text="@.recent_files" style="workspace_link" />
            <boxfiller />
            <buttonset id="recent_folders" columns="1">
              <item icon="icon_folder" tooltip="@.recent_folders" tooltip_dir="bottom" />
            </buttonset>
            <buttonset id="mode" columns="3" magnet="true">
                <item icon="list_view" tooltip="@.list_thumb" tooltip_dir="bottom" />
                <item icon="small_icon_view" tooltip="@.small_thumb" tooltip_dir="bottom" />
                <item icon="big_icon_view" tooltip="@.big_thumb" tooltip_dir="bottom" />
            </buttonset>
          </hbox>
          <view id="recents_view" expansive="true" style="none" />
        </vbox>
        <vbox id="sidepanel" childspacing="6" noborders="true" visible="false">
          <view id="sidepanel_view" style="workspace_view" expansive="true">
            <vbox id="sidepanel_box" childspacing="0" expansive="true">
              <hbox border="4" style="workspace_news_header">
                <label text="@.news"  />
                <boxfiller />
                <button id="close_sidepanel" icon="window_close_icon" />
              </hbox>
              <hbox id="notification" visible="false" style="workspace_update_notification">
                <link id="update_link" style="news_item" text="" /> <image icon="warning_box" />
              </hbox>
            </vbox>
          </view>
        </vbox>
      </splitter>
    </hbox>
    <hbox id="share_container" visible="false">
      <boxfiller/>
      <check id="share_crashdb" text="@.share_crashdb" tooltip="@.share_crashdb_tooltip" style="workspace_check_box" />
    </hbox>
  </vbox>
</gui>
